<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CSS Display </title>

    <style>
        .menu {
            list-style-type: none;
            padding: 0;
            margin: 0;
            text-align: center;
        }

        .menu li {
            display: inline-block;
            padding: 12px 25px;
            background-color: lightblue;
            margin: 0;
        }

        .menu li a {
            text-decoration: none;
            color: black;
            font-weight: bold;
        }

        .banner {
            width: 100%;
            height: 200px;
            background-color: lightgray;
            position: relative;
            margin-top: 30px;
        }

        .profile-pic {
            width: 80px;
            height: 60px;
            position: absolute;

            /* Bottom-left corner */
            left: 0;
            bottom: -20px;
        }

        .center-block {
            width: 50%;
            border: 3px solid blue;
            padding: 20px;
            margin: 60px auto;
            display: block;
            text-align: center;
        }

        .notification {
            position: fixed;
            bottom: 20px;
            right: 20px;

            background-color: orange;
            color: black;

            padding: 15px 25px;
            border: 2px solid black;
            border-radius: 8px;

            font-weight: bold;
        }

        .content {
            height: 1000px;
            padding: 20px;
        }

    </style>
</head>

<body>

    <h1>Task 1: Horizontal Menu</h1>

    <ul class="menu">

        <li>
            <a href="#">Home</a>
        </li>

        <li>
            <a href="#">About</a>
        </li>

        <li>
            <a href="#">Services</a>
        </li>

        <li>
            <a href="#">Portfolio</a>
        </li>

        <li>
            <a href="#">Contact</a>
        </li>

    </ul>

    <h1>Task 2: Profile Header</h1>

    <div class="banner">

        <h2>My Profile</h2>

        <img
            class="profile-pic"
            src="https://via.placeholder.com/80x60"
            alt="Profile Picture"
        >

    </div>

    <h1>Task 3: Centered Block</h1>

    <div class="center-block">

        <h2>Welcome</h2>

        <p>
            This block is centered horizontally
            using margin: 0 auto.
        </p>

    </div>

    <div class="notification">
        Update Available!
    </div>

    <div class="content">

        <h1>Scroll the Page</h1>

        <p>
            This content is added to create
            enough space for scrolling.
        </p>

        <p>
            Notice the "Update Available!"
            notification remains fixed at the
            bottom-right corner.
        </p>

        <p>
            CSS position: fixed keeps the
            notification in the same place
            even when the page is scrolled.
        </p>

    </div>


</body>
</html>
