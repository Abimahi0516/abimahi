</head>
<body>
    <div class="container mt-4">
        
    <div class="table-responsive">
    <h2 class="text-center mb-3">Employee Table</h2>
    <table class="table table-striped table-bordered" style="min-width: 700px;">
        <thead class="table-dark">
        <tr>
            <th>Employee ID</th>
            <th>Employee Name</th>
            <th>Department</th>
            <th>Salary</th>
        </tr>
