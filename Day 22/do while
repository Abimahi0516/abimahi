<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Do While Loop Functions</title>
</head>
<body>

<script>
    // DO WHILE LOOP

    // WITHOUT PARAMETER
    console.log("WITHOUT PARAMETER");

    // Q1: Series of 1 to 20
    let q1 = () =>
    {
        let s = "";
        let i = 1;

        do
        {
            s = s + i + " ";
            i++;
        } while(i <= 20);

        console.log("Q1:", s);
    }
    q1();

    // Q2: Odd numbers 1 to 20
    let q2 = () =>
    {
        let s = "";
        let i = 1;

        do
        {
            s = s + i + " ";
            i += 2;
        } while(i <= 20);

        console.log("Q2:", s);
    }
    q2();

    // Q3: Even numbers 0 to 20
    let q3 = () =>
    {
        let s = "";
        let i = 0;

        do
        {
            s = s + i + " ";
            i += 2;
        } while(i <= 20);

        console.log("Q3:", s);
    }
    q3();

    // Q4: 5 Series 0 to 25
    let q4 = () =>
    {
        let s = "";
        let i = 0;

        do
        {
            s = s + i + " ";
            i += 5;
        } while(i <= 25);

        console.log("Q4:", s);
    }
    q4();

    // Q5: 1 + 2 + 3 + ...
    let q5 = () =>
    {
        let s = "";
        let i = 1;

        do
        {
            s = s + i + " + ";
            i++;
        } while(i <= 10);

        console.log("Q5:", s);
    }
    q5();

    // Q6: 0 + 2 + 4 + 6 + ...
    let q6 = () =>
    {
        let s = "";
        let i = 0;

        do
        {
            s = s + i + " + ";
            i += 2;
        } while(i <= 20);

        console.log("Q6:", s);
    }
    q6();

    // Q7: 1 + 3 + 5 + 7 + ...
    let q7 = () =>
    {
        let s = "";
        let i = 1;

        do
        {
            s = s + i + " + ";
            i += 2;
        } while(i <= 20);

        console.log("Q7:", s);
    }
    q7();

    // Q8: 0 + 5 + 10 + 15 + 20 + ...
    let q8 = () =>
    {
        let s = "";
        let i = 0;

        do
        {
            s = s + i + " + ";
            i += 5;
        } while(i <= 20);

        console.log("Q8:", s);
    }
    q8();

    // Q9: 1/1! + 2/2! + 3/3! + ...
    let q9 = () =>
    {
        let s = "";
        let i = 1;

        do
        {
            s = s + i + "/" + i + "! + ";
            i++;
        } while(i <= 5);

        console.log("Q9:", s);
    }
    q9();

    // Q10: 0 + 2/2! + 4/4! + ...
    let q10 = () =>
    {
        let s = "";
        let i = 0;

        do
        {
            if(i == 0)
            {
                s = s + "0 + ";
            }
            else
            {
                s = s + i + "/" + i + "! + ";
            }

            i += 2;
        } while(i <= 6);

        console.log("Q10:", s);
    }
    q10();

    // Q11: 1/1! + 3/3! + 5/5! + ...
    let q11 = () =>
    {
        let s = "";
        let i = 1;

        do
        {
            s = s + i + "/" + i + "! + ";
            i += 2;
        } while(i <= 7);

        console.log("Q11:", s);
    }
    q11();

    // Q12: Factorial of a given number
    // 5! = 5 * 4 * 3 * 2 * 1 = 120
    let q12 = () =>
    {
        let n = 5;
        let fact = 1;
        let i = n;

        do
        {
            fact = fact * i;
            i--;
        } while(i >= 1);

        console.log("Q12:", fact);
    }
    q12();

    // Q13: Prime or Not
    let q13 = () =>
    {
        let n = 7;
        let count = 0;
        let i = 1;

        do
        {
            if(n % i == 0)
            {
                count++;
            }

            i++;
        } while(i <= n);

        if(count == 2)
        {
            console.log("Q13:", n + " is Prime");
        }
        else
        {
            console.log("Q13:", n + " is Not Prime");
        }
    }
    q13();

    // Q14: Prime Number Series
 
    let q14 = () =>
    {
        let n = 9;
        let count = 0;
        let i = 1;

        do
        {
            if(n % i == 0)
            {
                count++;
            }

            i++;
        } while(i <= n);

        if(count == 2)
        {
            console.log("Q14:", n + " is Prime");
        }
        else
        {
            console.log("Q14:", n + " is Not Prime");
        }
    }
    q14();

    </script>
</body>
</html>
