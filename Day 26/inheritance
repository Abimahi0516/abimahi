phone1.displaySmartPhone();

//task6 
class Area 
{ 
    Circumference(a, b) 
    { 
        if(arguments.length === 1) 
        { 
            let circumference = 4 * a; 
            console.log(`Circumference of Square: ${circumference}`); 
        } 
        else if(arguments.length === 2) 
        { 
            let circumference = 2 * (a + b); 
            console.log(`Circumference of Rectangle: ${circumference}`); 
        } 
        else if(arguments.length === 3) 
        { 
            let circumference = 2 * Math.PI * a; 
            console.log(`Circumference of Circle: ${circumference.toFixed(2)}`); 
        } 
        else 
        { 
            console.log("Invalid arguments"); 
        } 
    } 
} 
 
let area1 = new Area(); 
console.log("task6: Circumference:");
area1.Circumference(5); 
area1.Circumference(10, 6); 
area1.Circumference(7, 0, 0);

