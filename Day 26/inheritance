    <script>
    //task1: Employee Details 
     
    class Employee 
    { 
        constructor(empId, empName,salary) 
        { 
            this.empId = empId; 
            this.empName = empName; 
            this.salary = salary; 
        } 
        readEmployee() 
        { 
            this.empId = prompt("Enter Employee ID:"); 
            this.empName = prompt("Enter Employee Name:"); 
            this.salary = prompt("Enter salary:"); 
        } 
        displayEmployee() 
        { 
            console.log(`Employee ID: ${this.empId} \nEmployee Name: ${this.empName} \nSalary: ${this.salary}`); 
        } 
 
    } 
    let emp1 = new Employee(); 
    console.log("task1: Employee Details"); 
