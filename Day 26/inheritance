    emp1.displayEmployee(); 
//task2 
class Vehicle 
{ 
    constructor(vehicleType) 
    { 
        this.vehicleType = vehicleType; 
    } 
    displayInfo()
    { 
        console.log(`Vehicle Type: ${this.vehicleType}`); 
    } 
} 
class Car extends Vehicle 
{ 
    constructor(vehicleType, brand, year, model) 
    { 
        super(vehicleType); 
        this.brand = brand; 
        this.year = year; 
        this.model = model; 
    } 
    displayCarInfo() 
    { 
        this.displayInfo(); 
        console.log(`Brand: ${this.brand}, Year: ${this.year}, Model: ${this.model}`); 
    } 
} 
class SportsCar extends Car 
{ 
    constructor(vehicleType, brand, year, model, topSpeed, engineType)
    {
        super(vehicleType, brand, year, model);
        this.topSpeed = topSpeed;
        this.engineType = engineType;
    }

    displaySportsCarInfo()
    {
        this.displayCarInfo();
        console.log(`Top Speed: ${this.topSpeed}, Engine Type: ${this.engineType}`);
    }
} 
 
let car1 = new SportsCar("Car", "TATA", 2022, "Punch", "250 km/h", "V6"); 
console.log("task2: Car Details");
car1.displaySportsCarInfo();


//task3
class Shape
{
    display()
    {
        console.log("This is a Shape");
    }
}

class Rectangle extends Shape
{
    constructor(length, breadth)
    {
        super();
        this.length = length;
        this.breadth = breadth;
    }

    display()
    {
        let area = this.length * this.breadth;
        console.log(`Length: ${this.length}, Breadth: ${this.breadth}`);
        console.log(`Area of Rectangle: ${area}`);
    }
}

let rectangle1 = new Rectangle(20, 10);
console.log("task3: Area of Rectangle:")
rectangle1.display();

