class Device
{
    constructor(deviceName)
    {
        this.deviceName = deviceName;
    }

    displayDevice()
    {
        console.log(`Device Name: ${this.deviceName}`);
    }
}

class Mobile extends Device
{
    constructor(deviceName, model)
    {
        super(deviceName);
        this.model = model;
    }

    displayMobile()
    {
        this.displayDevice();
        console.log(`Model: ${this.model}`);
