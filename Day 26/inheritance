    {
        super(deviceName, model);
        this.os = os;
    }

    displaySmartPhone()
    {
        this.displayMobile();
        console.log(`OS: ${this.os}`);
    }
}

let phone1 = new SmartPhone("Mobile", "Vivoy58", "Android");
