class Shape2
{
    Draw(...args)
    {
        if(args.length === 1)
        {
            console.log(`Drawing Circle with Radius: ${args[0]}`);
        }
        else if(args.length === 2)
        {
            console.log(`Drawing Rectangle with Length: ${args[0]}, Breadth: ${args[1]}`);
        }
        else if(args.length === 3)
        {
            console.log(`Drawing Triangle with Sides: ${args[0]}, ${args[1]}, ${args[2]}`);
        }
        else
        {
            console.log("Invalid arguments");
        }
    }
}
let shape1 = new Shape2();
console.log("task7: Shape:")
shape1.Draw(5);
shape1.Draw(10, 6);
shape1.Draw(2,3,4);
