</html>

<!DOCTYPE html>
<html>
<head>
    <title>Task 4 - Image Gallery</title>
    <style>
        .gallery {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            grid-auto-rows: 150px;
            gap: 10px;
        }
        .gallery img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .image1 {
            grid-column: span 2;
            grid-row: span 2;
        }

        .image2 {
            grid-column: span 2;
        }

        .image3 {
            grid-row: span 2;
        }

        .image4 {
            grid-column: span 2;
        }

        .image5 {
            grid-column: span 2;
        }
    </style>
</head>
<body>
    <h2>Task 4 - Image Gallery</h2>
    <div class="gallery">
        <div class="image1">
            <img src="image/flower.jpg" alt="Image 1">
        </div>
        <div class="image2">
            <img src="image/flower.jpg" alt="Image 2">
        </div>
        <div class="image3">
            <img src="image/flower.jpg" alt="Image 3">
        </div>
        <div class="image4">
            <img src="image/flower.jpg" alt="Image 4">
        </div>
        <div class="image5">
            <img src="image/flower.jpg" alt="Image 5">
        </div>
    </div>
</body>
</html>


<!DOCTYPE html>
<html>
<head>
    <title>Task 5 - Dashboard Layout</title>
    <style>
        /* Dashboard Layout */
        .dashboard {
            display: grid;
            grid-template-columns: 200px 1fr;
            min-height: 500px;
        }

        /* Sidebar */
        .sidebar {
            background-color: lightgray;
            padding: 20px;
        }

        /* Right Side */
        .content {
            display: grid;
            grid-template-rows: 70px 1fr;
        }

        /* Top Navigation */
        .top-nav {
            background-color: lightblue;
            padding: 20px;
        }

        /* Main Content */
        .main {
            padding: 20px;
        }

        /* Stats Widgets - Nested Grid */
        .stats {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        /* Widgets */
        .widget {
            background-color: lightgreen;
            padding: 30px;
            text-align: center;
        }
    </style>
</head>
<body>
    <h2>Task 5 - Dashboard Layout</h2>
    <div class="dashboard">
        <!-- Sidebar -->
        <aside class="sidebar">
            <h2>Admin Panel</h2>
            <p>Dashboard</p>
            <p>Users</p>
            <p>Reports</p>
            <p>Settings</p>
        </aside>

        <!-- Right Content -->
        <div class="content">

            <!-- Top Navigation -->
            <nav class="top-nav">
                <h2>Dashboard</h2>
            </nav>

            <!-- Main Content -->
            <main class="main">

                <h3>Statistics</h3>

                <!-- Nested Grid -->
                <div class="stats">

                    <div class="widget">
                        <h3>Users</h3>
                        <p>1200</p>
                    </div>

                    <div class="widget">
                        <h3>Orders</h3>
                        <p>350</p>
                    </div>
                    <div class="widget">
                        <h3>Sales</h3>
                        <p>₹50,000</p>
                    </div>

                    <div class="widget">
                        <h3>Visitors</h3>
                        <p>5000</p>
                    </div>
                </div>
            </main>
        </div>
    </div>
</body>
</html>
